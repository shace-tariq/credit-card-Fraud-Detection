data/raw/*.csv
data/raw/*.zip
data/processed/*

# ---- Trained model artifacts ----
models/*.pkl
models/*.joblib

# ---- Generated report artifacts (keep curated markdown reports) ----
reports/figures/*.png
reports/figures/*.jpg
reports/*.json
reports/*.csv

# ---- OS noise ----
.DS_Store
Thumbs.db

# Keep placeholder directories tracked
!**/.gitkeep
